diff --git a/patches/mtld3d/0007-d3d9-Supply-the-MSVC-CRT-pieces-a-mingw-CRT-i686-lin.patch b/patches/mtld3d/0007-d3d9-Supply-the-MSVC-CRT-pieces-a-mingw-CRT-i686-lin.patch
new file mode 100644
index 0000000..25e1e18
--- /dev/null
+++ b/patches/mtld3d/0007-d3d9-Supply-the-MSVC-CRT-pieces-a-mingw-CRT-i686-lin.patch
@@ -0,0 +1,123 @@
+From 81bae2a7c53c5081405f4f03ccf23e867bd49dd3 Mon Sep 17 00:00:00 2001
+From: Alchemac <noreply@alchemac.invalid>
+Date: Mon, 16 Nov 2026 01:12:23 +0900
+Subject: [PATCH] d3d9: Supply the MSVC CRT pieces a mingw-CRT i686 link needs
+
+The ARM64X halves link llvm-mingw's CRT, and arm64_crt.rs supplies what
+MSVC's static CRT would otherwise define. Build the same way for i686
+(no MSVC CRT, so no xwin and no Microsoft licence) by compiling this
+module, renamed mingw_crt.rs, under --cfg mtld3d_mingw_crt as well. Only
+a build that passes that cfg is affected; the upstream MSVC i686 build
+is unchanged.
+
+For x86 the module adds __fltused and the absolute __tls_array symbol
+(0x2C, the TEB's ThreadLocalStoragePointer offset). __aulldiv, __aullrem
+and __chkstk are left to the link, which imports them from ntdll.dll;
+the type_info vtable and snmalloc's thread-exit TLS callback are shared
+with the ARM64 targets. The cfg is declared in build.rs.
+---
+ windows/d3d9/build.rs                         |  4 +++
+ windows/d3d9/src/lib.rs                       | 10 +++---
+ .../d3d9/src/{arm64_crt.rs => mingw_crt.rs}   | 31 +++++++++++++++++--
+ 3 files changed, 37 insertions(+), 8 deletions(-)
+ rename windows/d3d9/src/{arm64_crt.rs => mingw_crt.rs} (71%)
+
+diff --git a/windows/d3d9/build.rs b/windows/d3d9/build.rs
+index 07520da..e72dd38 100644
+--- a/windows/d3d9/build.rs
++++ b/windows/d3d9/build.rs
+@@ -21,6 +21,10 @@ fn main() {
+         println!("cargo:rustc-cfg=mtld3d_crumb");
+     }
+ 
++    // Set by RUSTFLAGS (`--cfg mtld3d_mingw_crt`) for a build that links
++    // llvm-mingw's CRT instead of MSVC's; see `src/mingw_crt.rs`.
++    println!("cargo::rustc-check-cfg=cfg(mtld3d_mingw_crt)");
++
+     println!("cargo::rustc-check-cfg=cfg(perf_tracking)");
+     println!("cargo:rerun-if-env-changed=MTLD3D_PERF");
+     if std::env::var("MTLD3D_PERF").is_ok_and(|v| !v.is_empty() && v != "0") {
+diff --git a/windows/d3d9/src/lib.rs b/windows/d3d9/src/lib.rs
+index 9c71f0b..f9a10c2 100644
+--- a/windows/d3d9/src/lib.rs
++++ b/windows/d3d9/src/lib.rs
+@@ -1,5 +1,5 @@
+-#[cfg(any(target_arch = "aarch64", target_arch = "arm64ec"))]
+-mod arm64_crt;
++#[cfg(any(target_arch = "aarch64", target_arch = "arm64ec", mtld3d_mingw_crt))]
++mod mingw_crt;
+ mod bound_buffers;
+ mod bound_rt;
+ mod capture;
+@@ -58,7 +58,7 @@ use crate::{direct3d9::Direct3D9, unix_call::unix_call};
+ const DLL_PROCESS_ATTACH: u32 = 1;
+ const DLL_PROCESS_DETACH: u32 = 0;
+ /// The reason a thread's exit gives a TLS callback, which only the ARM64X halves install.
+-#[cfg(any(target_arch = "aarch64", target_arch = "arm64ec"))]
++#[cfg(any(target_arch = "aarch64", target_arch = "arm64ec", mtld3d_mingw_crt))]
+ const DLL_THREAD_DETACH: u32 = 3;
+ 
+ /// Single source of truth for the `log` crate target, so callers don't hard-code the string.
+@@ -151,8 +151,8 @@ pub extern "system" fn dll_main(instance: *mut c_void, reason: u32, _reserved: *
+     if reason != DLL_PROCESS_ATTACH {
+         return 1;
+     }
+-    #[cfg(any(target_arch = "aarch64", target_arch = "arm64ec"))]
+-    arm64_crt::attach();
++    #[cfg(any(target_arch = "aarch64", target_arch = "arm64ec", mtld3d_mingw_crt))]
++    mingw_crt::attach();
+     init_logger(instance);
+     attach_process(instance);
+     1
+diff --git a/windows/d3d9/src/arm64_crt.rs b/windows/d3d9/src/mingw_crt.rs
+similarity index 71%
+rename from windows/d3d9/src/arm64_crt.rs
+rename to windows/d3d9/src/mingw_crt.rs
+index 99242c7..8fd15e4 100644
+--- a/windows/d3d9/src/arm64_crt.rs
++++ b/windows/d3d9/src/mingw_crt.rs
+@@ -1,9 +1,18 @@
+-//! What MSVC's static CRT supplies that the ARM64X link has no library for.
++//! What MSVC's static CRT supplies that a link against llvm-mingw's CRT has no library for.
+ //!
+-//! The i386 and `x86_64` DLLs link MSVC's `msvcrt.lib`, whose static part defines
++//! The upstream i386 and `x86_64` DLLs link MSVC's `msvcrt.lib`, whose static part defines
+ //! everything below. The two ARM64X halves link llvm-mingw's CRT instead (see
+ //! `windows-arm64x` in the Makefile), which defines none of it, and MSVC's
+-//! ARM64 and ARM64EC libraries are not available to this build.
++//! ARM64 and ARM64EC libraries are not available to this build. An i686 DLL
++//! linked the same way (no MSVC CRT, no Microsoft licence) is built with
++//! `--cfg mtld3d_mingw_crt`; the upstream MSVC i686 build never sets it and is
++//! unchanged. This module is compiled for the ARM64 targets and under that cfg.
++//!
++//! The i686 link additionally needs `__aulldiv`, `__aullrem` and `__chkstk`,
++//! which are not defined here: the link takes them from an import library for
++//! `ntdll.dll` (Wine's i386 ntdll exports `_aulldiv`, `_aullrem` and `_chkstk`
++//! with the MSVC calling conventions), made with `llvm-dlltool` from a three
++//! line `.def`.
+ 
+ use core::ffi::c_void;
+ 
+@@ -79,3 +88,19 @@ extern "system" fn on_tls_event(_module: *mut c_void, reason: u32, _reserved: *m
+         unsafe { _malloc_thread_cleanup() };
+     }
+ }
++
++/// MSVC's marker that a floating-point object was linked; it only has to exist.
++///
++/// `export_name` is the C name: on i686 the object file gets the usual leading
++/// underscore, so the symbol objects reference is `__fltused`.
++#[cfg(target_arch = "x86")]
++#[unsafe(export_name = "_fltused")]
++pub static FLTUSED: i32 = 0;
++
++// MSVC's thread-local storage reads the TLS array through the TEB:
++// `mov eax, fs:[__tls_array]`. The symbol is an absolute one, the offset of
++// `ThreadLocalStoragePointer` in the 32-bit TEB (0x2C), which `msvcrt.lib`
++// defines and llvm-mingw's CRT does not. Assembly names are literal, so this
++// is spelt as the objects reference it (`__tls_array`, no extra decoration).
++#[cfg(target_arch = "x86")]
++core::arch::global_asm!(".globl __tls_array", ".set __tls_array, 0x2C");
