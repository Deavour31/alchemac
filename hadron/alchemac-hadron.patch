+    printf '%s\n' "prefix-scoped stop" > "$HADRON_SCOPE_DIR/stop-request"
+    standalone_wine "$target" "$ROOT/dist/bin/wineserver" -k || exit 1
+    sleep 1
+    . "$ROOT/scripts/hadron-procs.sh" || exit 2
+    # The runtime directory is private to this exact prefix. Re-check both the
+    # PID start time and mapped runtime before terminating any orphan.
+    hadron_candidates | while read -r p rss start; do
+        is_hadron_process "$p" || continue
+        current=$(ps -p "$p" -o lstart= 2>/dev/null | tr -d ' :')
+        [ "$current" = "$start" ] && is_hadron_process "$p" && kill -9 "$p" 2>/dev/null
+    done
+    exit 0
+fi
