+++ b/scripts/standalone-common.sh
@@ -0,0 +1,40 @@
+# Shared scope checks for standalone-run, stop and the memory watchdog.
+# Every prefix has private APFS runtime copies. Their mapped paths identify its
+# processes without reading any process's environment or command-line secrets.
+standalone_scope_valid() {
+    [ -n "${WINEPREFIX:-}" ] && [ -n "${HADRON_SCOPE_DIR:-}" ] || return 1
+    [ -f "$HADRON_SCOPE_DIR/owner-prefix" ] || return 1
+    [ "$(cat "$HADRON_SCOPE_DIR/owner-prefix")" = "$WINEPREFIX" ] || return 1
+    case "$ROOT" in "$HADRON_SCOPE_DIR"/runtimes/*) ;; *) return 1 ;; esac
+    [ "$(dirname "$ROOT")" = "$HADRON_SCOPE_DIR/runtimes" ] || return 1
+    [ -f "$ROOT/BUILD-ID" ] && [ ! -L "$ROOT" ]
+}
+
+standalone_active_prefix() {
+    active="$WINEPREFIX"
+    if [ -f "$HADRON_SCOPE_DIR/active-prefix" ]; then
+        IFS= read -r active < "$HADRON_SCOPE_DIR/active-prefix" || return 1
+    fi
+    case "$active" in
+        "$WINEPREFIX") ;;
+        "$WINEPREFIX".hadron-new.*)
+            suffix=${active#"$WINEPREFIX".hadron-new.}
+            case "$suffix" in ''|*[!0-9]*) return 1 ;; esac ;;
+        *) return 1 ;;
+    esac
+    printf '%s\n' "$active"
+}
+
+# Only the prefix parameter changes between initialization and the real session.
+# UI runtimes and renderer settings are applied later by scripts/play.
+standalone_wine() {
+    target_prefix="$1"; shift
+    env -i HOME="$HOME" USER="$USER" LANG="${LANG:-en_US.UTF-8}" \
+        PATH=/usr/bin:/bin:/usr/sbin:/sbin TMPDIR="${TMPDIR:-/tmp}" \
+        WINEPREFIX="$target_prefix" WINEDEBUG=-all \
+        WINEDLLOVERRIDES="mscoree,mshtml=" \
+        DYLD_FALLBACK_LIBRARY_PATH="$ROOT/dist/ext/lib" FEX_DISKCACHE=0 \
+        "$@" 8>&- 9>&- &
+    wine_command_pid=$!
+    wait "$wine_command_pid"
+}
