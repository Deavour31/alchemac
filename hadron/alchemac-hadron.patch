diff --git a/patches/mtld3d/0004-d3d9-Let-GetDC-read-back-non-lockable-render-targets.patch b/patches/mtld3d/0004-d3d9-Let-GetDC-read-back-non-lockable-render-targets.patch
new file mode 100644
index 0000000..c27f0b6
--- /dev/null
+++ b/patches/mtld3d/0004-d3d9-Let-GetDC-read-back-non-lockable-render-targets.patch
@@ -0,0 +1,114 @@
+From 28e6e7780582b2de2e96b50ddfe4b17078943299 Mon Sep 17 00:00:00 2001
+From: Alchemac <noreply@alchemac.invalid>
+Date: Mon, 16 Nov 2026 00:30:17 +0900
+Subject: [PATCH] d3d9: Let GetDC read back non-lockable render targets and
+ back buffers
+
+WPF hardware rendering calls GetDC on its render target / back buffer, which
+is not lockable. GetDC returned D3DERR_INVALIDCALL for it, so GDI drawing
+into the surface failed.
+
+Treat any GPU-only colour surface (the implicit back buffer, or a standalone
+non-lockable render target) as a read-back target: GetDC flushes and reads the
+surface back into a snapshot the DIB wraps, and ReleaseDC uploads the page back.
+A standalone render target is marked read-back first so its colour stays live.
+
+---
+ windows/d3d9/src/surface.rs | 53 ++++++++++++++++++++++++++++++-------
+ 1 file changed, 44 insertions(+), 9 deletions(-)
+
+diff --git a/windows/d3d9/src/surface.rs b/windows/d3d9/src/surface.rs
+index a22707c..ca3a6f6 100644
+--- a/windows/d3d9/src/surface.rs
++++ b/windows/d3d9/src/surface.rs
+@@ -2499,6 +2499,11 @@ fn readback_full_backbuffer(inner: &mut SurfaceInner) -> Option<(u32, u32, u32)>
+     // SAFETY: `device_inner` is non-null (checked) and points to the live owning
+     // device, which outlives its child surfaces per D3D9 lifetime rules.
+     let device_inner = unsafe { &mut *inner.device_inner };
++    if inner.implicit_kind != ImplicitKind::Backbuffer {
++        // A standalone render target is read right after the flush: mark it
++        // read-back first so the store-action rules keep its colour live.
++        device_inner.push_control(crate::device::NoteColorReadOp { src: tex_handle });
++    }
+     device_inner.flush_current_frame_blocking().ok()?;
+     let mut params = BlitTextureToBufferParams {
+         planes: mtld3d_shared::mtl::ReadbackPlanes::Color,
+@@ -3087,6 +3092,25 @@ impl SurfaceInner {
+             && !self.live_color_handle().is_null()
+     }
+ 
++    /// True for a GPU-only colour surface whose `GetDC` goes through a read-back snapshot.
++    ///
++    /// The implicit back buffer (lockable or not) and a standalone,
++    /// non-lockable render target: colour texture, no CPU staging, no parent
++    /// texture. `GetDC` reads such a surface back into `readback` and the DIB
++    /// wraps that page; `ReleaseDC` uploads the page back. Depth-stencil
++    /// surfaces have no colour handle and never qualify.
++    fn is_dc_readback_target(&self) -> bool {
++        match self.implicit_kind {
++            ImplicitKind::Backbuffer => true,
++            ImplicitKind::None => {
++                self.parent_texture.is_null()
++                    && self.system_memory.is_none()
++                    && !self.live_color_handle().is_null()
++            }
++            ImplicitKind::DepthStencil => false,
++        }
++    }
++
+     /// Resolve the CPU pixel store this surface exposes through `GetDC`.
+     ///
+     /// `None` for a surface kind with no host-readable pixels (a GPU-only
+@@ -3125,7 +3149,7 @@ impl SurfaceInner {
+         // persistent CPU store. `surface_get_dc` performs a full read-back into
+         // `self.readback` immediately before this call, so a held DC reads the
+         // backbuffer's current pixels (BGRA8, matching the X8R8G8B8 DIB order).
+-        if self.implicit_kind == ImplicitKind::Backbuffer {
++        if self.is_dc_readback_target() {
+             let page = self.readback.as_ref()?;
+             let format = self.live_format();
+             let fmt = mtld3d_core::format::map_d3d_format(format)?;
+@@ -3279,13 +3303,24 @@ extern "system" fn surface_get_dc(this: *mut c_void, hdc: *mut *mut c_void) -> i
+     if (unsafe { &*inner.dc_lock_ptr() }).map_count != 0 {
+         return D3DERR_INVALIDCALL;
+     }
+-    // A LOCKABLE implicit backbuffer is GPU-only: snapshot it via a full
+-    // read-back into `readback` so `dc_pixels` (and the DIB it seeds) have host
+-    // pixels. A NON-lockable backbuffer rejects GetDC: the
+-    // `is_lockable_backbuffer` guard is false, so we skip the read-back and fall
+-    // through to `dc_pixels` → None → INVALIDCALL with the out-HDC left untouched.
+-    if inner.is_lockable_backbuffer() && readback_full_backbuffer(inner).is_none() {
+-        return D3DERR_INVALIDCALL;
++    // The implicit back buffer and a non-lockable render target are GPU-only:
++    // snapshot them via a full read-back into `readback` so `dc_pixels` (and
++    // the DIB it seeds) have host pixels, as WPF-style presenters expect from
++    // `GetDC` on a back buffer. A format with no GDI mapping is rejected before
++    // any GPU work.
++    if inner.is_dc_readback_target() {
++        if dc_format_info(inner.live_format()).is_none() {
++            mtld3d_shared::log_once_warn!(target: crate::LOG_TARGET,
++                "IDirect3DSurface9::GetDC: format has no GDI mapping → INVALIDCALL");
++            return D3DERR_INVALIDCALL;
++        }
++        if !inner.is_lockable_backbuffer() {
++            mtld3d_shared::log_once_warn!(target: crate::LOG_TARGET,
++                "IDirect3DSurface9::GetDC on a non-lockable render target / back buffer: using GPU read-back snapshot");
++        }
++        if readback_full_backbuffer(inner).is_none() {
++            return D3DERR_INVALIDCALL;
++        }
+     }
+     // A lockable standalone render target keeps its pixels in the colour
+     // texture the GPU writes and hands the DC a DIB over its CPU staging, so
+@@ -3447,7 +3482,7 @@ extern "system" fn surface_release_dc(this: *mut c_void, hdc: *mut c_void) -> i3
+     // The back buffer's DC wraps the read-back snapshot page rather than any
+     // persistent store, so GDI's drawing exists only there: push it back into
+     // the back buffer before the page is dropped just below.
+-    if inner.is_lockable_backbuffer() {
++    if inner.is_dc_readback_target() {
+         backbuffer_dc_upload(inner);
+     }
+     // A backbuffer GetDC stashed a full read-back snapshot in `readback`; drop it
+-- 
