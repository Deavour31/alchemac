@@ -0,0 +1,58 @@
+/* Standalone session regression fixture. Never reads real account data. */
+#define _WIN32_WINNT 0x0A00
+#include <windows.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <wchar.h>
+
+static void text(FILE *out, const wchar_t *value)
+{
+    char utf8[32768];
+    WideCharToMultiByte(CP_UTF8, 0, value, -1, utf8, sizeof(utf8), NULL, NULL);
+    fputs(utf8, out);
+}
+
+int wmain(int argc, wchar_t **argv)
+{
+    wchar_t cwd[32768], exe[32768], cmd[32768];
+    const wchar_t *blocked[] = {L"PRIVATE_TEST_TOKEN", L"SteamAppId", L"SteamGameId",
+        L"STEAM_COMPAT_DATA_PATH", L"STEAM_COMPAT_CLIENT_INSTALL_PATH",
+        L"STEAM_DYLD_INSERT_LIBRARIES", L"DYLD_INSERT_LIBRARIES"};
+    GetCurrentDirectoryW(32768, cwd);
+    printf("pid=%lu\ncwd=", GetCurrentProcessId()); text(stdout, cwd); putchar('\n');
+    for (int i = 0; i < argc; i++) {
+        printf("arg%d=", i); text(stdout, argv[i]); putchar('\n');
+    }
+    for (unsigned i = 0; i < sizeof(blocked) / sizeof(blocked[0]); i++) {
+        fputs("env:", stdout); text(stdout, blocked[i]);
+        printf("=%s\n", GetEnvironmentVariableW(blocked[i], NULL, 0) ? "PRESENT" : "absent");
+    }
+    fflush(stdout);
+    if (argc < 2) return 2;
+    if (!wcscmp(argv[1], L"exit")) return argc > 2 ? _wtoi(argv[2]) : 0;
+    if (argc < 4) return 2;
+    if (!wcscmp(argv[1], L"spawn")) {
+        STARTUPINFOW si = {sizeof(si)};
+        PROCESS_INFORMATION pi;
+        GetModuleFileNameW(NULL, exe, 32768);
+        swprintf(cmd, 32768, L"\"%ls\" wait \"%ls\" %ls", exe, argv[2], argv[3]);
+        if (!CreateProcessW(NULL, cmd, NULL, NULL, TRUE, 0, NULL, NULL, &si, &pi)) {
+            printf("CreateProcess failed %lu\n", GetLastError()); return 3;
+        }
+        CloseHandle(pi.hThread); CloseHandle(pi.hProcess);
+        puts("parent exiting while child is alive");
+        return 0;
+    }
+    if (wcscmp(argv[1], L"wait")) return 2;
+    DWORD duration = wcstoul(argv[3], NULL, 10), start = GetTickCount();
+    unsigned beat = 0;
+    do {
+        FILE *out = _wfopen(argv[2], L"wb");
+        if (!out) return 4;
+        fprintf(out, "pid=%lu\nbeat=%u\ncwd=", GetCurrentProcessId(), beat++);
+        text(out, cwd); fputs("\n", out); fclose(out);
+        Sleep(200);
+    } while (GetTickCount() - start < duration);
+    puts("fixture completed");
+    return 0;
+}
