diff --git a/scripts/prefix-init.sh b/scripts/prefix-init.sh
new file mode 100644
index 0000000..6e6dad4
--- /dev/null
+++ b/scripts/prefix-init.sh
@@ -0,0 +1,74 @@
+# Generic ARM64 prefix initialization. Sourced by standalone-run with its lock held.
+# The Steam entry point keeps its original initialization until separately tested.
+prefix_machine() {
+    pe_offset=$(od -An -tu4 -j60 -N4 "$1" 2>/dev/null | tr -d ' ')
+    case "$pe_offset" in ''|*[!0-9]*) return 1 ;; esac
+    od -An -tx2 -j "$((pe_offset + 4))" -N2 "$1" 2>/dev/null | tr -d ' '
+}
+
+# FEX keys its disk cache on host features and configuration, not on its code
+# generator, so a new runtime would reuse code the previous FEX compiled. The
+# migration snapshot keeps the old cache for a rollback with the old runtime.
+# Only real directories inside the prefix are removed, never a linked host path.
+prefix_drop_fex_cache() {
+    for local in "$WINEPREFIX"/drive_c/users/*/AppData/Local; do
+        cache="$local/fex-emu/DiskCache"
+        [ -d "$cache" ] || continue
+        appdata=$(dirname "$local")
+        for part in "$(dirname "$appdata")" "$appdata" "$local" "$local/fex-emu" "$cache"; do
+            [ ! -L "$part" ] || { echo "standalone: linked FEX cache path left in place: $cache" >&2; continue 2; }
+        done
+        rm -rf "$cache" || return 1
+        echo "standalone: FEX code cache cleared for the new runtime"
+    done
+}
+
+prefix_prepare() {
+    id=$(runtime_id "$ROOT")
+    [ -n "$id" ] || { echo "standalone: runtime has no BUILD-ID" >&2; return 1; }
+    if [ -e "$WINEPREFIX" ]; then
+        [ -f "$WINEPREFIX/.hadron-prefix-ready" ] &&
+        [ "$(prefix_machine "$WINEPREFIX/drive_c/windows/system32/ntdll.dll")" = aa64 ] || {
+            echo "standalone: refusing an incomplete or foreign prefix: $WINEPREFIX" >&2
+            return 1
+        }
+        [ ! -f "$WINEPREFIX/.hadron-migration-incomplete" ] || {
+            echo "standalone: prefix migration incomplete; restore its recorded snapshot" >&2
+            return 1
+        }
+    else
+        stage="$WINEPREFIX.hadron-new.$$"
+        [ ! -e "$stage" ] || { echo "standalone: staging path already exists" >&2; return 1; }
+        # Let Wine create the disposable configuration directory itself.
+        printf '%s\n' "$stage" > "$HADRON_SCOPE_DIR/active-prefix"
+        echo "standalone: initializing a new ARM64 prefix"
+        if standalone_wine "$stage" "$ROOT/dist/bin/wine" wineboot --init &&
+           standalone_wine "$stage" "$ROOT/dist/bin/wineserver" -w &&
+           "$ROOT/scripts/mtld3d-prefix" enable "$stage" &&
+           [ "$(prefix_machine "$stage/drive_c/windows/system32/ntdll.dll")" = aa64 ]; then
+            printf '%s\n' "$id" > "$stage/.hadron-prefix-ready"
+            mv "$stage" "$WINEPREFIX" || return 1
+            stage=
+        else
+            standalone_wine "$stage" "$ROOT/dist/bin/wineserver" -k || true
+            echo "standalone: initialization failed; only its staging prefix will be removed" >&2
+            return 1
+        fi
+    fi
+    printf '%s\n' "$WINEPREFIX" > "$HADRON_SCOPE_DIR/active-prefix"
+    previous=$(cat "$WINEPREFIX/.hadron-prefix-ready")
+    if [ "$previous" != "$id" ]; then
+        backup="$WINEPREFIX.backup.$(date +%Y%m%d-%H%M%S).$$"
+        cp -c -R "$WINEPREFIX" "$backup" 2>/dev/null || {
+            [ ! -e "$backup" ] || { echo "standalone: partial snapshot at $backup" >&2; return 1; }
+            cp -R "$WINEPREFIX" "$backup" || return 1
+        }
+        printf '%s\n' "$backup" > "$WINEPREFIX/.hadron-migration-incomplete"
+        echo "standalone: prefix snapshot saved before runtime migration: $backup"
+        prefix_drop_fex_cache || return 1
+        standalone_wine "$WINEPREFIX" "$ROOT/dist/bin/wine" wineboot --update &&
+        standalone_wine "$WINEPREFIX" "$ROOT/dist/bin/wineserver" -w || return 1
+        printf '%s\n' "$id" > "$WINEPREFIX/.hadron-prefix-ready"
+        rm "$WINEPREFIX/.hadron-migration-incomplete"
+    fi
+}
diff --git a/scripts/standalone-common.sh b/scripts/standalone-common.sh
new file mode 100644
index 0000000..d4eb06f
--- /dev/null
+++ b/scripts/standalone-common.sh
@@ -0,0 +1,40 @@
+# Shared scope checks for standalone-run, stop and the memory watchdog.
+# Every prefix has private APFS runtime copies. Their mapped paths identify its
+# processes without reading any process's environment or command-line secrets.
+standalone_scope_valid() {
+    [ -n "${WINEPREFIX:-}" ] && [ -n "${HADRON_SCOPE_DIR:-}" ] || return 1
+    [ -f "$HADRON_SCOPE_DIR/owner-prefix" ] || return 1
+    [ "$(cat "$HADRON_SCOPE_DIR/owner-prefix")" = "$WINEPREFIX" ] || return 1
+    case "$ROOT" in "$HADRON_SCOPE_DIR"/runtimes/*) ;; *) return 1 ;; esac
+    [ "$(dirname "$ROOT")" = "$HADRON_SCOPE_DIR/runtimes" ] || return 1
+    [ -f "$ROOT/BUILD-ID" ] && [ ! -L "$ROOT" ]
+}
+
+standalone_active_prefix() {
+    active="$WINEPREFIX"
+    if [ -f "$HADRON_SCOPE_DIR/active-prefix" ]; then
+        IFS= read -r active < "$HADRON_SCOPE_DIR/active-prefix" || return 1
+    fi
+    case "$active" in
+        "$WINEPREFIX") ;;
+        "$WINEPREFIX".hadron-new.*)
+            suffix=${active#"$WINEPREFIX".hadron-new.}
+            case "$suffix" in ''|*[!0-9]*) return 1 ;; esac ;;
+        *) return 1 ;;
+    esac
+    printf '%s\n' "$active"
+}
+
+# Only the prefix parameter changes between initialization and the real session.
+# UI runtimes and renderer settings are applied later by scripts/play.
+standalone_wine() {
+    target_prefix="$1"; shift
+    env -i HOME="$HOME" USER="$USER" LANG="${LANG:-en_US.UTF-8}" \
+        PATH=/usr/bin:/bin:/usr/sbin:/sbin TMPDIR="${TMPDIR:-/tmp}" \
+        WINEPREFIX="$target_prefix" WINEDEBUG=-all \
+        WINEDLLOVERRIDES="mscoree,mshtml=" \
+        DYLD_FALLBACK_LIBRARY_PATH="$ROOT/dist/ext/lib" FEX_DISKCACHE=0 \
+        "$@" 8>&- 9>&- &
+    wine_command_pid=$!
+    wait "$wine_command_pid"
+}
diff --git a/scripts/standalone-run b/scripts/standalone-run
new file mode 100755
index 0000000..62c6c5b
--- /dev/null
+++ b/scripts/standalone-run
@@ -0,0 +1,123 @@
+#!/bin/sh
+# Non-Steam session supervisor. No game-specific code or Windows binary changes.
+# WINEPREFIX, HADRON_SUPPORT and HADRON_LOGS must be absolute explicit paths.
+# Usage: standalone-run <safe-id> <absolute-exe> [args...]
+ROOT=$(cd "$(dirname "$0")/.." && pwd -P) || exit 1
+[ $# -ge 2 ] || { echo "usage: $0 <safe-id> <absolute-exe> [args...]" >&2; exit 2; }
+case "$1" in ''|*[!A-Za-z0-9_-]*) echo "standalone: invalid id" >&2; exit 2 ;; esac
+case "$2" in /*) ;; *) echo "standalone: EXE must be an absolute path" >&2; exit 2 ;; esac
+[ -f "$2" ] || { echo "standalone: EXE not found" >&2; exit 2; }
+
+# Do not inherit host tokens, Steam state, DYLD injection or unrelated Wine vars.
+if [ "${HADRON_STANDALONE_ENV_READY:-0}" != 1 ]; then
+    set -- /bin/sh "$ROOT/scripts/standalone-run" "$@"
+    for name in WINEPREFIX WINEDEBUG WINEDLLOVERRIDES HADRON_SUPPORT HADRON_LOGS \
+        HADRON_WORKDIR HADRON_APP_NAME HADRON_LOG HADRON_MEM_LIMIT_GB \
+        HADRON_SWAP_LIMIT_MB HADRON_DISK_MIN_GB HADRON_VSYNC HADRON_D3D9 \
+        HADRON_D3D12 HADRON_PRECISE_SCROLLING HADRON_HARDWARE_TSO \
+        HADRON_LARGE_ADDRESS_AWARE DXMT_CONFIG MTLD3D_CONFIG \
+        FEX_DISKCACHE FEX_BLOCKJITNAMING MTL_HUD_ENABLED DOTNET_BUNDLE_EXTRACT_BASE_DIR LC_ALL; do
+        if value=$(printenv "$name"); then set -- "$name=$value" "$@"; fi
+    done
+    exec env -i HOME="$HOME" USER="$USER" PATH=/usr/bin:/bin:/usr/sbin:/sbin \
+        TMPDIR="${TMPDIR:-/tmp}" LANG="${LANG:-en_US.UTF-8}" \
+        HADRON_STANDALONE_ENV_READY=1 "$@"
+fi
+
+for path in "${WINEPREFIX:-}" "${HADRON_SUPPORT:-}" "${HADRON_LOGS:-}"; do
+    case "$path" in /*) ;; *) echo "standalone: explicit absolute prefix/support/log paths required" >&2; exit 2 ;; esac
+    case "$path" in /|"$HOME"|*'
+'*) echo "standalone: unsafe path" >&2; exit 2 ;; esac
+done
+[ ! -L "$WINEPREFIX" ] || { echo "standalone: prefix symlinks are not accepted" >&2; exit 2; }
+mkdir -p "$(dirname "$WINEPREFIX")" "$HADRON_SUPPORT" "$HADRON_LOGS" || exit 1
+WINEPREFIX="$(cd "$(dirname "$WINEPREFIX")" && pwd -P)/$(basename "$WINEPREFIX")"
+case "$(basename "$WINEPREFIX")" in .|..) echo "standalone: unsafe prefix name" >&2; exit 2 ;; esac
+BASE=${HADRON_STANDALONE_BASE_SUPPORT:-$HADRON_SUPPORT}
+BASE=$(cd "$BASE" && pwd -P) || exit 1
+case "$BASE/" in "$WINEPREFIX/"*) echo "standalone: support must be outside the prefix" >&2; exit 2 ;; esac
+key=$(printf '%s' "$WINEPREFIX" | /sbin/md5 -q)
+HADRON_SCOPE_DIR="$BASE/prefix-sessions/$key"
+HADRON_SUPPORT="$HADRON_SCOPE_DIR"
+mkdir -p "$HADRON_SCOPE_DIR" || exit 1
+if [ -e "$HADRON_SCOPE_DIR/owner-prefix" ]; then
+    [ "$(cat "$HADRON_SCOPE_DIR/owner-prefix")" = "$WINEPREFIX" ] || exit 1
+else
+    printf '%s\n' "$WINEPREFIX" > "$HADRON_SCOPE_DIR/owner-prefix"
+fi
+export WINEPREFIX HADRON_SUPPORT HADRON_LOGS HADRON_SCOPE_DIR
+export HADRON_STANDALONE_BASE_SUPPORT="$BASE"
+export HADRON_PROCESS_SCOPE=prefix HADRON_RUNTIME_ENTRYPOINT=standalone-run
+
+# A sibling lock survives prefix creation/rename, and is shared across support roots.
+if [ "${HADRON_STANDALONE_LOCK_PID:-}" != "$$" ]; then
+    lock="$(dirname "$WINEPREFIX")/.$(basename "$WINEPREFIX").hadron-session.lock"
+    [ ! -L "$lock" ] || exit 2
+    exec 8>>"$lock" || exit 1
+    if ! lockf -s -t 0 8; then echo "standalone: session already running" >&2; exit 75; fi
+    export HADRON_STANDALONE_LOCK_PID=$$
+fi
+
+. "$ROOT/scripts/paths.sh"
+. "$ROOT/scripts/runtime-versions.sh"
+runtime_lock || { echo "standalone: runtime selection lock failed" >&2; exit 1; }
+chosen=$(runtime_of_session)
+if [ -z "$chosen" ]; then
+    case "$ROOT" in
+        "$HADRON_RUNTIMES"/*) source=$(runtime_source) ;;
+        *) source="$ROOT" ;;
+    esac
+    chosen=$(runtime_copy "$source") || { runtime_unlock; exit 1; }
+    runtime_point "$chosen" || { runtime_unlock; exit 1; }
+    printf '%s\n' "$source" > "$HADRON_SUPPORT/source"
+fi
+runtime_unlock
+if [ "$chosen" != "$ROOT" ]; then
+    [ -x "$chosen/scripts/standalone-run" ] || { echo "standalone: selected runtime has no entry point" >&2; exit 1; }
+    exec "$chosen/scripts/standalone-run" "$@"
+fi
+. "$ROOT/scripts/standalone-common.sh"
+standalone_scope_valid || { echo "standalone: scope mismatch" >&2; exit 1; }
+# Wine 0.3.0's bootstrap can truncate builtin DLL paths near MAX_PATH. Refuse
+# deep support roots before touching a prefix; the default user Library path is
+# short enough. This conservative bound also leaves room for bootstrap helpers.
+[ "${#ROOT}" -le 180 ] || {
+    echo "standalone: runtime path too long for Wine bootstrap; use a shorter HADRON_SUPPORT" >&2
+    exit 2
+}
+# Orphaned Wine in a prefix must be stopped rather than implicitly joined.
+[ -z "$(runtime_of_session)" ] || { echo "standalone: existing unmanaged Wine session; stop it first" >&2; exit 75; }
+runtime_mark "$ROOT"
+stage= watcher=
+cleanup() {
+    status=$?
+    trap - EXIT TERM INT HUP
+    if [ -n "$watcher" ]; then kill "$watcher" 2>/dev/null; wait "$watcher" 2>/dev/null; fi
+    if [ "$status" -ne 0 ]; then "$ROOT/scripts/stop" >/dev/null 2>&1; fi
+    if [ -n "$stage" ] && [ "$stage" = "$WINEPREFIX.hadron-new.$$" ]; then rm -rf "$stage"; fi
+    runtime_unmark "$ROOT"
+    rm -f "$HADRON_SCOPE_DIR/active-prefix"
+    exec 8>&-
+    exit "$status"
+}
+trap cleanup EXIT
+trap '"$ROOT/scripts/stop"; exit 143' TERM INT HUP
+rm -f "$HADRON_SCOPE_DIR/stop-request"
+printf '%s\n' "$WINEPREFIX" > "$HADRON_SCOPE_DIR/active-prefix"
+log="$HADRON_LOGS/$1-$$.session.log"
+exec >>"$log" 2>&1
+echo "standalone: runtime $(runtime_id "$ROOT"); session=$$"
+printf '%s\n' "$$" > "$HADRON_SCOPE_DIR/supervisor-pid"
+# Always exactly one watchdog, attached to the supervisor, including initialization.
+"$ROOT/scripts/watchdog" "$HADRON_LOGS/$1-$$.mem.log" "$$" 8>&- &
+watcher=$!
+. "$ROOT/scripts/prefix-init.sh"
+prefix_prepare || exit 1
+export HADRON_STANDALONE=1 HADRON_WATCHDOG=0
+"$ROOT/scripts/play" "$@" 8>&- &
+child=$!
+wait "$child"; first_status=$?
+echo "standalone: initial process exit=$first_status; waiting for the whole Wine session"
+standalone_wine "$WINEPREFIX" "$ROOT/dist/bin/wineserver" -w || exit 1
+[ ! -f "$HADRON_SCOPE_DIR/stop-request" ] || exit 143
+exit "$first_status"
