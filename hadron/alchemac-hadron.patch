diff --git a/patches/wine/0034-ntdll-Clear-decommitted-guest-pages-sharing-a-host-p.patch b/patches/wine/0034-ntdll-Clear-decommitted-guest-pages-sharing-a-host-p.patch
new file mode 100644
index 0000000..0fe2ff6
--- /dev/null
+++ b/patches/wine/0034-ntdll-Clear-decommitted-guest-pages-sharing-a-host-p.patch
@@ -0,0 +1,152 @@
+From 0f269f7c2803c90a977ff4e0d8cf96bb8d48cd00 Mon Sep 17 00:00:00 2001
+From: Lennard Zehner <127147155+Moeweneier@users.noreply.github.com>
+Date: Fri, 16 Oct 2026 14:33:52 +0200
+Subject: [PATCH] ntdll: Clear partial decommitted host pages through writable
+ aliases.
+
+On 16K macOS hosts, boundary 4K guest pages retained stale contents on
+recommit. Clear partial boundaries without relaxing the host permissions
+of committed neighbours: use temporary shared writable aliases for
+ordinary pages, and the existing per-thread write mode for MAP_JIT pages.
+Prepare both aliases before writing and release them on failure.
+
+Whole host pages keep anonymous remapping; round whole-view decommit
+consistently for small views. Other hosts keep their existing boundary
+behaviour. The macOS path incurs up to two alias map/protect/unmap cycles.
+
+The 17-case zero/preservation regression passes on x86_64 and i386.
+A concurrent ARM64 writer cannot modify the protected neighbour; the old
+path with a diagnostic delay reproduces successful protected writes.
+
+---
+ dlls/ntdll/unix/virtual.c | 95 +++++++++++++++++++++++++++++++++++++--
+ 1 file changed, 92 insertions(+), 3 deletions(-)
+
+diff --git a/dlls/ntdll/unix/virtual.c b/dlls/ntdll/unix/virtual.c
+index 1b2c7db6af..e7b091da3d 100644
+--- a/dlls/ntdll/unix/virtual.c
++++ b/dlls/ntdll/unix/virtual.c
+@@ -2685,6 +2685,71 @@ static SIZE_T get_committed_size( struct file_view *view, void *base, size_t max
+ }
+ 
+ 
++#ifdef __APPLE__
++/* Clear partial host pages without changing permissions on committed neighbours. */
++static NTSTATUS zero_partial_host_pages( struct file_view *view, char *base, size_t size )
++{
++    struct
++    {
++        char *base;
++        size_t size;
++        mach_vm_address_t alias;
++        BOOL jit;
++    } partial[2] = {{0}};
++    char *end = base + size;
++    char *host_start = (char *)ROUND_SIZE( 0, base, host_page_mask );
++    char *host_end = ROUND_ADDR( end, host_page_mask );
++    vm_prot_t cur_prot, max_prot;
++    kern_return_t ret = KERN_SUCCESS;
++    unsigned int i;
++
++    partial[0].base = base;
++    partial[0].size = min( host_start, end ) - base;
++    partial[1].base = host_end;
++    if (host_end >= host_start && host_end < end) partial[1].size = end - host_end;
++
++    /* Prepare both aliases before writing, so a preparation failure leaves data intact. */
++    for (i = 0; i < 2; i++)
++    {
++        char *host_base = ROUND_ADDR( partial[i].base, host_page_mask );
++        if (!partial[i].size) continue;
++#ifdef WX_EXCLUSIVE_HOST
++        partial[i].jit = is_jit_view( view ) && (get_host_page_vprot( host_base ) & VPROT_EXECMODE);
++        if (partial[i].jit) continue;
++#endif
++        ret = mach_vm_remap( mach_task_self(), &partial[i].alias, host_page_size, 0, VM_FLAGS_ANYWHERE,
++                             mach_task_self(), (mach_vm_address_t)host_base, FALSE,
++                             &cur_prot, &max_prot, VM_INHERIT_NONE );
++        if (ret) break;
++        ret = mach_vm_protect( mach_task_self(), partial[i].alias, host_page_size, FALSE,
++                               VM_PROT_READ | VM_PROT_WRITE );
++        if (ret) break;
++    }
++    if (!ret) for (i = 0; i < 2; i++)
++    {
++        char *host_base = ROUND_ADDR( partial[i].base, host_page_mask );
++        if (!partial[i].size) continue;
++#ifdef WX_EXCLUSIVE_HOST
++        if (partial[i].jit)
++        {
++            /* MAP_JIT cannot be aliased; its write permission is already per thread. */
++            pthread_jit_write_protect_np( 0 );
++            memset( partial[i].base, 0, partial[i].size );
++            pthread_jit_write_protect_np( 1 );
++            sys_icache_invalidate( partial[i].base, partial[i].size );
++            continue;
++        }
++#endif
++        memset( (char *)partial[i].alias + (partial[i].base - host_base), 0, partial[i].size );
++        /* The original VA may retain executable instructions after an alias write. */
++        sys_icache_invalidate( partial[i].base, partial[i].size );
++    }
++    for (i = 0; i < 2; i++)
++        if (partial[i].alias) mach_vm_deallocate( mach_task_self(), partial[i].alias, host_page_size );
++    return ret ? STATUS_ACCESS_DENIED : STATUS_SUCCESS;
++}
++#endif
++
+ /***********************************************************************
+  *           decommit_pages
+  *
+@@ -2693,14 +2758,30 @@ static SIZE_T get_committed_size( struct file_view *view, void *base, size_t max
+  */
+ static NTSTATUS decommit_pages( struct file_view *view, char *base, size_t size )
+ {
+-    char *host_end, *host_start = (char *)ROUND_SIZE( 0, base, host_page_mask );
++    char *host_end, *end;
++#ifdef __APPLE__
++    char *partial_end;
++#endif
++    char *host_start = (char *)ROUND_SIZE( 0, base, host_page_mask );
+ 
+     if (!size)
+     {
+         size = view->size;
+-        host_end = host_start + view->size;
++        /* A whole view has no committed neighbour in its final host page. */
++        host_end = (char *)ROUND_SIZE( 0, base + size, host_page_mask );
+     }
+-    else host_end = ROUND_ADDR( base + size, host_page_mask );
++    else
++    {
++#ifdef __APPLE__
++        NTSTATUS status = zero_partial_host_pages( view, base, size );
++        if (status) return status;
++#endif
++        host_end = ROUND_ADDR( base + size, host_page_mask );
++    }
++    end = base + size;
++#ifdef __APPLE__
++    partial_end = min( host_start, end );
++#endif
+ 
+     if (host_start < host_end) anon_mmap_fixed( host_start, host_end - host_start, PROT_NONE, 0 );
+ #ifdef WX_EXCLUSIVE_HOST
+@@ -2711,6 +2792,14 @@ static NTSTATUS decommit_pages( struct file_view *view, char *base, size_t size
+     }
+ #endif
+     set_page_vprot_bits( base, size, 0, VPROT_COMMITTED );
++
++#ifdef __APPLE__
++    if (base < partial_end && mprotect_range( base, partial_end - base, 0, 0 ))
++        return STATUS_ACCESS_DENIED;
++    if (host_end >= host_start && host_end < end && mprotect_range( host_end, end - host_end, 0, 0 ))
++        return STATUS_ACCESS_DENIED;
++
++#endif
+     if (host_start < host_end) kernel_writewatch_register_range( view, host_start, host_end - host_start );
+     return STATUS_SUCCESS;
+ }
+-- 
+2.47.1
+
diff --git a/patches/wine/0035-ntdll-Clear-writable-partial-host-pages-in-place.patch b/patches/wine/0035-ntdll-Clear-writable-partial-host-pages-in-place.patch
new file mode 100644
index 0000000..a61fb8a
--- /dev/null
+++ b/patches/wine/0035-ntdll-Clear-writable-partial-host-pages-in-place.patch
@@ -0,0 +1,173 @@
+From 2da3375d2d13eeef2e101ac2b6e4df46152c7ec8 Mon Sep 17 00:00:00 2001
+From: Broyojo <dha@xoba.com>
+Date: Fri, 16 Oct 2026 16:45:40 -0400
+Subject: [PATCH] ntdll: Clear writable partial host pages in place.
+
+A host page that is already writable needs no alias: zero the decommitted
+guest pages directly. Call mprotect afterwards only when the host page's
+protection changes, which also leaves a MAP_JIT page's backing in place
+under a neighbour that may be running. Invalidate the instruction cache
+for any host page with an executable guest page, including one that is
+flipped to write mode at the moment.
+
+Whole and partial decommits take the same path: a boundary host page is
+replaced whole only when nothing else in it is in use, neither a committed
+guest page of the view nor another view, and otherwise cleared page by
+page. Replacing it releases the backing that writing zeros would fault in,
+as for a view shorter than its host page.
+---
+ dlls/ntdll/unix/virtual.c | 86 +++++++++++++++++++++++++++++----------
+ 1 file changed, 64 insertions(+), 22 deletions(-)
+
+diff --git a/dlls/ntdll/unix/virtual.c b/dlls/ntdll/unix/virtual.c
+index e7b091da3d..73e4dc56ce 100644
+--- a/dlls/ntdll/unix/virtual.c
++++ b/dlls/ntdll/unix/virtual.c
+@@ -2686,25 +2686,44 @@ static SIZE_T get_committed_size( struct file_view *view, void *base, size_t max
+ 
+ 
+ #ifdef __APPLE__
+-/* Clear partial host pages without changing permissions on committed neighbours. */
+-static NTSTATUS zero_partial_host_pages( struct file_view *view, char *base, size_t size )
++/* Whether the host page at host_base holds anything in use besides [start, end) of the view: a
++ * committed guest page of the view, or another view (split placeholders can share a host page). */
++static BOOL host_page_in_use_outside( struct file_view *view, const char *host_base,
++                                      const char *start, const char *end )
++{
++    const char *page, *view_start = view->base, *view_end = view_start + view->size;
++
++    for (page = host_base; page < host_base + host_page_size; page += page_size)
++    {
++        if (page >= start && page < end) continue;
++        if (page < view_start || page >= view_end)
++        {
++            if (find_view( page, 0 )) return TRUE;
++        }
++        else if (get_page_vprot( page ) & VPROT_COMMITTED) return TRUE;
++    }
++    return FALSE;
++}
++
++/* Clear the guest pages of [base, end) outside [host_start, host_end) without changing
++ * permissions on committed neighbours. */
++static NTSTATUS zero_partial_host_pages( struct file_view *view, char *base, char *end,
++                                         char *host_start, char *host_end )
+ {
+     struct
+     {
+         char *base;
+         size_t size;
+         mach_vm_address_t alias;
++        BYTE vprot;
+         BOOL jit;
+     } partial[2] = {{0}};
+-    char *end = base + size;
+-    char *host_start = (char *)ROUND_SIZE( 0, base, host_page_mask );
+-    char *host_end = ROUND_ADDR( end, host_page_mask );
+     vm_prot_t cur_prot, max_prot;
+     kern_return_t ret = KERN_SUCCESS;
+     unsigned int i;
+ 
+     partial[0].base = base;
+-    partial[0].size = min( host_start, end ) - base;
++    if (base < host_start) partial[0].size = min( host_start, end ) - base;
+     partial[1].base = host_end;
+     if (host_end >= host_start && host_end < end) partial[1].size = end - host_end;
+ 
+@@ -2717,6 +2736,9 @@ static NTSTATUS zero_partial_host_pages( struct file_view *view, char *base, siz
+         partial[i].jit = is_jit_view( view ) && (get_host_page_vprot( host_base ) & VPROT_EXECMODE);
+         if (partial[i].jit) continue;
+ #endif
++        /* A host page that is already writable is cleared in place, with no alias. */
++        partial[i].vprot = get_host_page_vprot( host_base );
++        if (get_unix_prot( partial[i].vprot ) & PROT_WRITE) continue;
+         ret = mach_vm_remap( mach_task_self(), &partial[i].alias, host_page_size, 0, VM_FLAGS_ANYWHERE,
+                              mach_task_self(), (mach_vm_address_t)host_base, FALSE,
+                              &cur_prot, &max_prot, VM_INHERIT_NONE );
+@@ -2740,9 +2762,12 @@ static NTSTATUS zero_partial_host_pages( struct file_view *view, char *base, siz
+             continue;
+         }
+ #endif
+-        memset( (char *)partial[i].alias + (partial[i].base - host_base), 0, partial[i].size );
+-        /* The original VA may retain executable instructions after an alias write. */
+-        sys_icache_invalidate( partial[i].base, partial[i].size );
++        if (partial[i].alias)
++            memset( (char *)partial[i].alias + (partial[i].base - host_base), 0, partial[i].size );
++        else
++            memset( partial[i].base, 0, partial[i].size );
++        /* An executable page may have run code from here, even one now flipped to write mode. */
++        if (partial[i].vprot & VPROT_EXEC) sys_icache_invalidate( partial[i].base, partial[i].size );
+     }
+     for (i = 0; i < 2; i++)
+         if (partial[i].alias) mach_vm_deallocate( mach_task_self(), partial[i].alias, host_page_size );
+@@ -2761,23 +2786,31 @@ static NTSTATUS decommit_pages( struct file_view *view, char *base, size_t size
+     char *host_end, *end;
+ #ifdef __APPLE__
+     char *partial_end;
++    int head_prot, tail_prot;
+ #endif
+     char *host_start = (char *)ROUND_SIZE( 0, base, host_page_mask );
++    BOOL whole = !size;
+ 
+-    if (!size)
++    if (whole) size = view->size;
++#ifdef __APPLE__
++    host_end = ROUND_ADDR( base + size, host_page_mask );
+     {
+-        size = view->size;
+-        /* A whole view has no committed neighbour in its final host page. */
+-        host_end = (char *)ROUND_SIZE( 0, base + size, host_page_mask );
++        char *head = ROUND_ADDR( base, host_page_mask );
++        NTSTATUS status;
++
++        /* A partial host page with nothing else in use is replaced whole: that zeroes it and
++         * releases its backing, which writing zeros would instead fault in. One shared with
++         * committed pages or another view is cleared page by page, whole view or not. */
++        if (head < host_start && !host_page_in_use_outside( view, head, base, base + size ))
++            host_start = head;
++        if (host_end < base + size && !host_page_in_use_outside( view, host_end, base, base + size ))
++            host_end += host_page_size;
++        if ((status = zero_partial_host_pages( view, base, base + size, host_start, host_end )))
++            return status;
+     }
+-    else
+-    {
+-#ifdef __APPLE__
+-        NTSTATUS status = zero_partial_host_pages( view, base, size );
+-        if (status) return status;
++#else
++    host_end = whole ? host_start + size : ROUND_ADDR( base + size, host_page_mask );
+ #endif
+-        host_end = ROUND_ADDR( base + size, host_page_mask );
+-    }
+     end = base + size;
+ #ifdef __APPLE__
+     partial_end = min( host_start, end );
+@@ -2790,13 +2823,22 @@ static NTSTATUS decommit_pages( struct file_view *view, char *base, size_t size
+         /* the replaced host pages are no longer MAP_JIT-backed */
+         if (host_start < host_end) set_page_vprot_bits( host_start, host_end - host_start, 0, VPROT_EXECMODE );
+     }
++#endif
++#ifdef __APPLE__
++    head_prot = get_unix_prot( get_host_page_vprot( base ) );
++    tail_prot = get_unix_prot( get_host_page_vprot( host_end ) );
+ #endif
+     set_page_vprot_bits( base, size, 0, VPROT_COMMITTED );
+ 
+ #ifdef __APPLE__
+-    if (base < partial_end && mprotect_range( base, partial_end - base, 0, 0 ))
++    /* Committed neighbours usually keep a partial host page's protection unchanged; leaving it
++     * alone also keeps a MAP_JIT page's backing in place under a neighbour that may be running. */
++    if (base < partial_end && get_unix_prot( get_host_page_vprot( base ) ) != head_prot &&
++        mprotect_range( base, partial_end - base, 0, 0 ))
+         return STATUS_ACCESS_DENIED;
+-    if (host_end >= host_start && host_end < end && mprotect_range( host_end, end - host_end, 0, 0 ))
++    if (host_end >= host_start && host_end < end &&
++        get_unix_prot( get_host_page_vprot( host_end ) ) != tail_prot &&
++        mprotect_range( host_end, end - host_end, 0, 0 ))
+         return STATUS_ACCESS_DENIED;
+ 
+ #endif
+-- 
+2.54.0 (Apple Git-157)
+
diff --git a/patches/wine/0036-ntdll-Map-unaligned-shared-image-sections-as-private.patch b/patches/wine/0036-ntdll-Map-unaligned-shared-image-sections-as-private.patch
new file mode 100644
index 0000000..9d591c6
--- /dev/null
+++ b/patches/wine/0036-ntdll-Map-unaligned-shared-image-sections-as-private.patch
@@ -0,0 +1,62 @@
+From 9187e812cd03114bb3d304c51d2ef34cf5d9d766 Mon Sep 17 00:00:00 2001
+From: Broyojo <dha@xoba.com>
+Date: Fri, 16 Oct 2026 18:05:36 -0400
+Subject: [PATCH] ntdll: Map unaligned shared image sections as private copies.
+
+A writable shared section is mapped from wineserver's shared-section file,
+which needs whole host pages. With host pages larger than the image's (16 KB
+on Apple silicon), a section that shares its host pages with other sections,
+or sits at an unaligned offset in that file, cannot be mapped shared, and the
+image failed to load. Map a private copy of such a section instead: correct
+for one process, but not shared with other instances of the image. A private
+copy also skips the private remapping of an import directory inside the
+section, which only a shared mapping needs.
+---
+ dlls/ntdll/unix/virtual.c | 22 ++++++++++++++++++----
+ 1 file changed, 18 insertions(+), 4 deletions(-)
+
+diff --git a/dlls/ntdll/unix/virtual.c b/dlls/ntdll/unix/virtual.c
+index 73e4dc56ce..b1d805dd25 100644
+--- a/dlls/ntdll/unix/virtual.c
++++ b/dlls/ntdll/unix/virtual.c
+@@ -3509,19 +3509,33 @@ static NTSTATUS map_image_into_view( struct file_view *view, const UNICODE_STRIN
+         if ((sec[i].Characteristics & IMAGE_SCN_MEM_SHARED) &&
+             (sec[i].Characteristics & IMAGE_SCN_MEM_WRITE))
+         {
++            char *addr = ptr + sec[i].VirtualAddress;
++            unsigned int shared_vprot = VPROT_COMMITTED | VPROT_READ | VPROT_WRITE;
++
+             TRACE_(module)( "%s mapping shared section %.8s at %p off %x (%x) size %lx (%lx) flags %x\n",
+-                            debugstr_us(nt_name), sec[i].Name, ptr + sec[i].VirtualAddress,
++                            debugstr_us(nt_name), sec[i].Name, addr,
+                             sec[i].PointerToRawData, (int)pos, file_size, map_size,
+                             sec[i].Characteristics );
++            /* A shared mapping needs whole host pages. With host pages larger than the image's
++             * pages, a section sharing its host pages with others can only get a private copy:
++             * correct for one process, but not shared with other instances of the image. */
++            if (((UINT_PTR)addr & host_page_mask) || (pos & host_page_mask) ||
++                ((map_size & host_page_mask) && addr + map_size < (char *)view->base + view->size))
++            {
++                FIXME_(module)( "%s shared section %.8s is not host page aligned, mapping a private copy\n",
++                                debugstr_us(nt_name), sec[i].Name );
++                shared_vprot = VPROT_COMMITTED | VPROT_READ | VPROT_WRITECOPY;
++            }
+             if (map_file_into_view( view, shared_fd, sec[i].VirtualAddress, map_size, pos,
+-                                    VPROT_COMMITTED | VPROT_READ | VPROT_WRITE, FALSE ) != STATUS_SUCCESS)
++                                    shared_vprot, FALSE ) != STATUS_SUCCESS)
+             {
+                 ERR_(module)( "Could not map %s shared section %.8s\n", debugstr_us(nt_name), sec[i].Name );
+                 goto done;
+             }
+ 
+-            /* check if the import directory falls inside this section */
+-            if (imports && imports->VirtualAddress >= sec[i].VirtualAddress &&
++            /* check if the import directory falls inside this section; a private copy needs no
++             * private remapping of it */
++            if ((shared_vprot & VPROT_WRITE) && imports && imports->VirtualAddress >= sec[i].VirtualAddress &&
+                 imports->VirtualAddress < sec[i].VirtualAddress + map_size)
+             {
+                 UINT_PTR base = imports->VirtualAddress & ~host_page_mask;
+-- 
+2.54.0 (Apple Git-157)
