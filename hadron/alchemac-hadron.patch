 # Stop every Hadron Wine process (all prefixes), including orphans whose wineserver is gone.
 # Leaves the native Mac Steam client and other Wine installations alone (see hadron-procs.sh).
 ROOT="$(cd "$(dirname "$0")/.." && pwd)"
+if [ "${HADRON_PROCESS_SCOPE:-runtime}" = prefix ]; then
+    . "$ROOT/scripts/standalone-common.sh"
