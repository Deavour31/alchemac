new file mode 100644
index 0000000..3df316c
--- /dev/null
+++ b/tests/mac/test-standalone.py
@@ -0,0 +1,222 @@
+#!/usr/bin/env python3
+"""Real Wine integration tests; explicit disposable runtime/prefix/fixture only."""
+import argparse
+import hashlib
+import json
+import os
+from pathlib import Path
+import shutil
+import signal
+import subprocess
+import time
+
+parser = argparse.ArgumentParser()
+parser.add_argument('--runtime', type=Path, required=True)
+parser.add_argument('--fixture', type=Path, required=True)
+parser.add_argument('--seed-prefix', type=Path, required=True)
+parser.add_argument('--state', type=Path, required=True)
+parser.add_argument('--out', type=Path, required=True)
+args = parser.parse_args()
+runtime, fixture, state, out = (p.resolve() for p in (args.runtime, args.fixture, args.state, args.out))
+assert not state.exists(), 'Use a fresh disposable state directory for each run'
+state.mkdir(parents=True)
+out.mkdir(parents=True, exist_ok=True)
+support = state / 'support'
+processes = []
+results = []
+
+
+def check(name, condition):
+    results.append({'test': name, 'passed': bool(condition)})
+    (out / 'results.json').write_text(json.dumps(results, indent=2))
+    print(('ok   ' if condition else 'FAIL ') + name, flush=True)
+    if not condition:
+        raise AssertionError(name)
+
+
+def until(predicate, seconds=20):
+    deadline = time.monotonic() + seconds
+    while time.monotonic() < deadline:
+        if predicate():
+            return True
+        time.sleep(.2)
+    return False
+
+
+def clone(source, dest):
+    subprocess.run(['/bin/cp', '-c', '-R', str(source), str(dest)], check=True)
+
+
+def prefix(name):
+    path = state / name
+    clone(args.seed_prefix.resolve(), path)
+    return path
+
+
+def scope(path):
+    key = hashlib.md5(str(path).encode()).hexdigest()
+    return support / 'prefix-sessions' / key
+
+
+def current_runtime(path):
+    return (scope(path) / 'runtime').resolve()
+
+
+def environment(path, **extra):
+    env = {k: os.environ[k] for k in ('HOME', 'USER', 'TMPDIR') if k in os.environ}
+    env.update(PATH='/usr/bin:/bin:/usr/sbin:/sbin', LANG='en_US.UTF-8',
+               WINEPREFIX=str(path), HADRON_SUPPORT=str(support), HADRON_LOGS=str(out / path.name),
+               PRIVATE_TEST_TOKEN='fixture-dummy-value', SteamAppId='not-a-steam-app',
+               STEAM_COMPAT_DATA_PATH='/nonexistent-steam-library',
+               STEAM_COMPAT_CLIENT_INSTALL_PATH='/nonexistent-steam-client',
+               STEAM_DYLD_INSERT_LIBRARIES='/nonexistent-overlay', FEX_DISKCACHE='0',
+               WINEDEBUG='-all,+loaddll')
+    env.update(extra)
+    return env
+
+
+def start(path, mode, marker='unused', ms='0', *, rt=runtime, cwd=None, more=()):
+    env = environment(path, **({'HADRON_WORKDIR': str(cwd)} if cwd else {}))
+    dest = out / (path.name + '-' + str(len(processes)) + '.outer.log')
+    with dest.open('w') as log:
+        p = subprocess.Popen([str(rt / 'scripts/standalone-run'), 'fixture', str(fixture),
+                              mode, str(marker), str(ms), *more], env=env,
+                             stdout=log, stderr=subprocess.STDOUT)
+    processes.append(p)
+    return p
+
+
+def session_text(path):
+    return '\n'.join(p.read_text(errors='replace') for p in (out / path.name).glob('*.session.log'))
+
+
+def memory_text(path):
+    return '\n'.join(p.read_text(errors='replace') for p in (out / path.name).glob('*.mem.log'))
+
+
+def beat(path):
+    try:
+        return path.read_text()
+    except FileNotFoundError:
+        return ''
+
+
+def stop(p):
+    p.send_signal(signal.SIGTERM)
+    return p.wait(timeout=20)
+
+
+def scoped_env(path):
+    return dict(environment(path), HADRON_SCOPE_DIR=str(scope(path)), HADRON_PROCESS_SCOPE='prefix')
+
+
+try:
+    a, b = prefix('prefix-a'), prefix('prefix-b')
+    cwd = state / 'working space 한글'
+    cwd.mkdir()
+    marker = cwd / 'ready 한글.txt'
+    literal = '$(touch SHOULD_NOT_EXIST)'
+    p = start(a, 'wait', marker.name, '1800', cwd=cwd, more=('a "quoted" value', literal))
+    check('spaces and Unicode working directory executes', until(marker.exists, 60))
+    check('normal standalone session returns exit 0', p.wait(timeout=25) == 0)
+    text = session_text(a)
+    check('quoted and shell-like arguments preserved literally', 'arg4=a "quoted" value' in text and 'arg5=' + literal in text)
+    check('no shell injection', not (cwd / 'SHOULD_NOT_EXIST').exists())
+    check('Steam and host secret variables removed', '=PRESENT' not in text and text.count('=absent') >= 7)
+    check('custom working directory reaches Windows', str(cwd).replace('/', '\\') in beat(marker))
+    check('watchdog starts and records this session', 'procs=' in memory_text(a))
+    check('Steam bridge not staged into prefix', not (a / 'drive_c/Program Files (x86)/Steam/steam.exe').exists())
+    check('no hadron-steam execution or lsteamclient module', 'hadron-steam.exe' not in text and 'lsteamclient.dll' not in text)
+
+    marker_a, marker_b = state / 'a.txt', state / 'b.txt'
+    pa = start(a, 'spawn', marker_a, '120000')
+    parent_log = out / a.name / ('fixture-' + str(pa.pid) + '.session.log')
+    check('launcher can start a child and exit', until(lambda: marker_a.exists() and parent_log.exists() and 'initial process exit=0' in parent_log.read_text(), 60))
+    check('supervisor stays for the child', pa.poll() is None)
+    pb = start(b, 'wait', marker_b, '150000')
+    check('second prefix starts concurrently', until(marker_b.exists, 60))
+    check('two prefixes use different mapped runtime directories', current_runtime(a) != current_runtime(b))
+    check('watchdog still runs after initial launcher exits', until(lambda: 'procs=' in memory_text(a)))
+    before = beat(marker_a)
+    duplicate = subprocess.run([str(runtime / 'scripts/standalone-run'), 'fixture', str(fixture), 'exit', '0'],
+                               env=environment(a), capture_output=True, text=True, timeout=10)
+    check('same-prefix duplicate refused with exit 75', duplicate.returncode == 75 and 'already running' in duplicate.stderr)
+    check('refusing duplicate does not stop original child', until(lambda: beat(marker_a) != before))
+    before_b = beat(marker_b)
+    check('TERM stops only first prefix with exit 143', stop(pa) == 143)
+    check('second prefix continues after first is stopped', pb.poll() is None and until(lambda: beat(marker_b) != before_b))
+    check('stopped prefix heartbeat no longer changes', (lambda value: (time.sleep(.8), beat(marker_a) == value)[1])(beat(marker_a)))
+
+    pa = start(a, 'wait', marker_a, '45000')
+    old = beat(marker_a)
+    check('stopped prefix can restart', until(lambda: beat(marker_a) != old))
+    wrong = scoped_env(b)
+    wrong['HADRON_SCOPE_DIR'] = str(scope(a))
+    refused = subprocess.run([str(current_runtime(a) / 'scripts/stop')], env=wrong,
+                             capture_output=True, text=True, timeout=10)
+    check('mismatched prefix scope refuses termination', refused.returncode == 2 and pa.poll() is None and pb.poll() is None)
+    threshold_env = dict(scoped_env(a), HADRON_MEM_LIMIT_GB='0')
+    wd = subprocess.Popen([str(current_runtime(a) / 'scripts/watchdog'), str(out / 'threshold.mem.log'), str(pa.pid)],
+                          env=threshold_env, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
+    check('watchdog memory cap causes a real scoped stop', wd.wait(timeout=20) == 1 and pa.wait(timeout=20) == 143)
+    before_b = beat(marker_b)
+    check('other prefix survives watchdog action', pb.poll() is None and until(lambda: beat(marker_b) != before_b))
+    check('second prefix stops cleanly', stop(pb) == 143)
+
+    # An actual new adapter build with unchanged Wine binaries exercises prefix
+    # snapshots and build pinning, without updating the game or live code.
+    newer = state / 'updated-runtime'
+    clone(runtime, newer)
+    next_id = (runtime / 'BUILD-ID').read_text().strip() + '-next'
+    (newer / 'BUILD-ID').write_text(next_id + '\n')
+    marker_a.unlink(missing_ok=True)
+    pa = start(a, 'wait', marker_a, '6500')
+    check('old runtime session starts before update', until(marker_a.exists))
+    old_runtime = current_runtime(a)
+    dup = subprocess.run([str(newer / 'scripts/standalone-run'), 'fixture', str(fixture), 'exit', '0'],
+                         env=environment(a), capture_output=True, text=True, timeout=10)
+    check('updated source cannot replace active prefix runtime', dup.returncode == 75 and current_runtime(a) == old_runtime)
+    check('active old session finishes normally', pa.wait(timeout=25) == 0)
+    (a / 'user-data.txt').write_text('keep-me')
+    fex_cache = a / 'drive_c/users' / os.environ['USER'] / 'AppData/Local/fex-emu/DiskCache'
+    (fex_cache / 'bucket').mkdir(parents=True, exist_ok=True)
+    (fex_cache / 'bucket/RWCacheDB_old.foz').write_text('compiled by the old runtime')
+    p = start(a, 'exit', '0', rt=newer)
+    check('new build starts after idle prefix migration', p.wait(timeout=65) == 0)
+    check('new runtime selected and prefix version recorded', current_runtime(a) != old_runtime and (a / '.hadron-prefix-ready').read_text().strip() == next_id)
+    backups = sorted(state.glob('prefix-a.backup.*'))
+    check('migration snapshot and user data preserved', bool(backups) and (a / 'user-data.txt').read_text() == 'keep-me')
+    snapshot_cache = backups[-1] / fex_cache.relative_to(a) / 'bucket/RWCacheDB_old.foz'
+    check('migration drops the old FEX code cache and keeps it in the snapshot',
+          not (fex_cache / 'bucket/RWCacheDB_old.foz').exists() and snapshot_cache.exists())
+    # Restore the snapshot as well as the matching runtime for rollback.
+    a.rename(state / 'prefix-a.after-migration')
+    clone(backups[-1], a)
+    p = start(a, 'exit', '0')
+    check('snapshot plus matching old runtime can roll back', p.wait(timeout=30) == 0 and current_runtime(a) == old_runtime)
+    check('restored user data preserved', (a / 'user-data.txt').read_text() == 'keep-me')
+
+    for label, argv, expected in [
+        ('unsafe id rejected', ['../bad', str(fixture)], 2),
+        ('relative EXE rejected', ['fixture', 'relative.exe'], 2),
+    ]:
+        proc = subprocess.run([str(runtime / 'scripts/standalone-run'), *argv], env=environment(a), capture_output=True, timeout=10)
+        check(label, proc.returncode == expected)
+    foreign = state / 'foreign'
+    foreign.mkdir()
+    (foreign / 'keep.txt').write_text('must-not-delete')
+    p = start(foreign, 'exit', '0')
+    check('foreign or incomplete prefix refused', p.wait(timeout=20) != 0)
+    check('foreign data never deleted', (foreign / 'keep.txt').read_text() == 'must-not-delete')
+
+    print('all standalone integration checks passed', flush=True)
+finally:
+    for p in processes:
+        if p.poll() is None:
+            p.terminate()
+            try:
+                p.wait(timeout=20)
+            except subprocess.TimeoutExpired:
+                # Leave the precise scope and PID evidence; never global-kill Wine.
+                print('cleanup needs attention for supervisor', p.pid, flush=True)
+    (out / 'results.json').write_text(json.dumps(results, indent=2))
