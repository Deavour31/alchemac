diff --git a/patches/mtld3d/0005-d3d9-Keep-an-additional-swap-chain-s-back-buffer-ali.patch b/patches/mtld3d/0005-d3d9-Keep-an-additional-swap-chain-s-back-buffer-ali.patch
new file mode 100644
index 0000000..54e028f
--- /dev/null
+++ b/patches/mtld3d/0005-d3d9-Keep-an-additional-swap-chain-s-back-buffer-ali.patch
@@ -0,0 +1,150 @@
+From adb32d1e3507ec8766d03263ebb201bedf433989 Mon Sep 17 00:00:00 2001
+From: Alchemac <noreply@alchemac.invalid>
+Date: Mon, 16 Nov 2026 00:30:17 +0900
+Subject: [PATCH] d3d9: Keep an additional swap chain's back buffer alive while
+ the app holds it
+
+With WPF hardware rendering the app can Release an additional swap chain
+while still holding its back buffer, then Release the back buffer later. The
+swap chain finalize freed the back buffer surface, so the later Release
+crashed on freed memory.
+
+Orphan the back buffer instead of freeing it when the app still references it:
+mark it ORPHANED and clear its swap chain pointer, so its own last Release
+frees it like an ordinary surface.
+
+---
+ windows/d3d9/src/surface.rs   | 65 +++++++++++++++++++++++++++++++----
+ windows/d3d9/src/swapchain.rs |  5 +--
+ 2 files changed, 62 insertions(+), 8 deletions(-)
+
+diff --git a/windows/d3d9/src/surface.rs b/windows/d3d9/src/surface.rs
+index ca3a6f6..4c84996 100644
+--- a/windows/d3d9/src/surface.rs
++++ b/windows/d3d9/src/surface.rs
+@@ -677,6 +677,18 @@ impl Direct3DSurface9 {
+         self.inner().flags.contains(SurfaceFlags::CONTAINER_CACHED)
+     }
+ 
++    /// Whether this implicit-kind surface may be freed by its own last release.
++    ///
++    /// True for an ordinary surface and for an orphaned swapchain back buffer;
++    /// false for a device-owned implicit surface still owned by its owner and
++    /// for a container-cached sub-surface.
++    fn freed_by_own_release(&self) -> bool {
++        let inner = self.inner();
++        (inner.implicit_kind == ImplicitKind::None
++            || inner.flags.contains(SurfaceFlags::ORPHANED))
++            && !inner.flags.contains(SurfaceFlags::CONTAINER_CACHED)
++    }
++
+     /// Whether this surface currently has an outstanding `LockRect`.
+     ///
+     /// D3D9 rejects `UpdateSurface` and `GetDC` when the surface is mapped. A
+@@ -1058,6 +1070,14 @@ bitflags::bitflags! {
+         /// `finalize_texture` is the single free site. Clear for every other
+         /// surface, freed on its own last release.
+         const CONTAINER_CACHED = 1 << 2;
++        /// A swapchain-owned `Backbuffer` surface whose swapchain was released while the app still held it.
++        ///
++        /// D3D9 keeps such a back buffer valid until the app's last `Release`, so
++        /// the surface is detached from the (freed) swapchain: it finalizes on its
++        /// own last public/private release like an ordinary surface, and its
++        /// `container` is cleared. It still resolves its Metal handle live from
++        /// the device, which its own forwarded device reference keeps alive.
++        const ORPHANED = 1 << 3;
+     }
+ }
+ 
+@@ -1589,7 +1609,7 @@ unsafe fn finalize_surface(this: *mut Direct3DSurface9) {
+     // first). Any other path here with a live `implicit_kind` is a gating bug
+     // that would free a surface the device still hands out — fail loudly.
+     debug_assert!(
+-        inner.implicit_kind == ImplicitKind::None,
++        inner.implicit_kind == ImplicitKind::None || inner.flags.contains(SurfaceFlags::ORPHANED),
+         "device-owned implicit surface finalized outside device teardown"
+     );
+     // Same invariant for a container-cached sub-surface: only
+@@ -1714,6 +1734,41 @@ pub unsafe fn finalize_implicit_surface(ptr: u64) {
+     unsafe { finalize_surface(surf) };
+ }
+ 
++/// Tear down a swapchain-owned back buffer surface when its swapchain is finalized.
++///
++/// If the app no longer references the surface (public and private counts both
++/// zero) it is finalized like [`finalize_implicit_surface`]. Otherwise it is
++/// orphaned instead of freed: D3D9 keeps a back buffer the app still holds valid
++/// after its swapchain is released. The surface is marked `ORPHANED` (so its own
++/// last `Release` frees it) and its swapchain back-pointer is cleared so nothing
++/// dereferences the freed swapchain. It keeps its forwarded device reference and
++/// resolves its Metal handle live from the device, so `GetDesc`, `GetDevice`,
++/// `AddRef`, `Release` and `QueryInterface` keep working.
++///
++/// # Safety
++/// `ptr` must be `0` or a live swapchain-owned `Backbuffer`-kind surface that
++/// the swapchain is about to stop owning; the pointer must not be used again by
++/// the caller.
++pub unsafe fn orphan_or_finalize_backbuffer(ptr: u64) {
++    if ptr == 0 {
++        return;
++    }
++    let surf = ptr as *mut Direct3DSurface9;
++    // SAFETY: `surf` is the live cached back buffer surface wrapper.
++    let (public, private) = unsafe { ((*surf).refcount, (*surf).private_refcount) };
++    if public == 0 && private == 0 {
++        // SAFETY: nothing references it; sole owner finalizes.
++        unsafe { finalize_implicit_surface(ptr) };
++        return;
++    }
++    log::debug!(target: crate::LOG_TARGET, "Direct3DSurface9 this={ptr:#x} ORPHANED (swapchain released, app still holds {public} public/{private} private)");
++    // SAFETY: `inner` is the surface's valid `SurfaceInner`; access is exclusive
++    // (single-threaded D3D9 objects or serialised by the device `ApiLock`).
++    let inner = unsafe { &mut *(*surf).inner };
++    inner.flags.insert(SurfaceFlags::ORPHANED);
++    inner.container = 0;
++}
++
+ /// Finalize a container-cached sub-resource surface at its container's teardown.
+ ///
+ /// Mirrors [`finalize_implicit_surface`]: clear the ownership marker first so
+@@ -1806,10 +1861,8 @@ impl ComUnknown for Direct3DSurface9 {
+             // at their owner's teardown, which keeps the cached pointer their
+             // owner hands out valid (see `ImplicitKind` and
+             // `SurfaceFlags::CONTAINER_CACHED`).
+-            let finalize_now = obj.refcount == 0
+-                && obj.private_refcount == 0
+-                && obj.inner().implicit_kind == ImplicitKind::None
+-                && !obj.container_cached();
++            let finalize_now =
++                obj.refcount == 0 && obj.private_refcount == 0 && obj.freed_by_own_release();
+             (finalize_now, obj.forward_texture())
+         };
+         if finalize_now {
+@@ -1881,7 +1934,7 @@ unsafe impl crate::com_ref::ComChild for Direct3DSurface9 {
+         // Implicit surfaces are never freed by `Release` — they are destroyed
+         // only at device teardown (see `ImplicitKind`), and neither is a
+         // container-cached sub-surface, freed by its texture's finalize.
+-        self.inner().implicit_kind == ImplicitKind::None && !self.container_cached()
++        self.freed_by_own_release()
+     }
+     fn blocks_reset_while_referenced(&self) -> bool {
+         // The implicit surfaces, and the standalone `D3DPOOL_DEFAULT` ones
+diff --git a/windows/d3d9/src/swapchain.rs b/windows/d3d9/src/swapchain.rs
+index 2f7c789..1ff1d2d 100644
+--- a/windows/d3d9/src/swapchain.rs
++++ b/windows/d3d9/src/swapchain.rs
+@@ -199,8 +199,9 @@ unsafe fn finalize_swapchain(this: *mut Direct3DSwapChain9) {
+     let backbuffer_surface = unsafe { (*inner).backbuffer_surface };
+     if backbuffer_surface != 0 {
+         // SAFETY: a non-zero `backbuffer_surface` is a live `Backbuffer`-kind
+-        // surface created by this swapchain; finalized exactly once here.
+-        unsafe { crate::surface::finalize_implicit_surface(backbuffer_surface) };
++        // surface created by this swapchain; finalized, or orphaned if the app
++        // still references it, exactly once here.
++        unsafe { crate::surface::orphan_or_finalize_backbuffer(backbuffer_surface) };
+     }
+     // SAFETY: as above — sole owner of the inner allocation.
+     drop(unsafe { Box::from_raw(inner) });
+-- 
+2.54.0 (Apple Git-157)
+
diff --git a/patches/mtld3d/0006-d3d9-Rename-contended-staging-before-UpdateSurface-a.patch b/patches/mtld3d/0006-d3d9-Rename-contended-staging-before-UpdateSurface-a.patch
