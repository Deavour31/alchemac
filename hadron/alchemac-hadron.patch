+From c942af77d26d70b391d52bf0d21ab38c7000fa5d Mon Sep 17 00:00:00 2001
+From: Alchemac <noreply@alchemac.invalid>
+Date: Mon, 16 Nov 2026 00:30:17 +0900
+Subject: [PATCH] d3d9: Rename contended staging before UpdateSurface and fill
+ writes
+
+WPF updates its glyph atlas with UpdateSurface between draws. The write went
+straight into a staging buffer an earlier recorded upload still reads, so
+those draws sampled the new bytes and showed wrong glyphs.
+
+Add prepare_staging_write, which renames a contended 2D level's staging before
+a CPU write exactly as LockRect does, and call it from the UpdateSurface /
+UpdateTexture copy and convert paths, the texture-to-texture region copy and
+the solid fill.
+
+---
+ windows/d3d9/src/texture.rs | 27 ++++++++++++++++++++++++++-
+ 1 file changed, 26 insertions(+), 1 deletion(-)
+
+diff --git a/windows/d3d9/src/texture.rs b/windows/d3d9/src/texture.rs
+index e9c6490..0c312c4 100644
+--- a/windows/d3d9/src/texture.rs
++++ b/windows/d3d9/src/texture.rs
+@@ -1263,7 +1263,7 @@ impl TextureInner {
+         if !self.ensure_staging_for_write(dst_level, whole) {
+             return false;
+         }
+-        self.prepare_volume_staging_write(dst_level);
++        self.prepare_staging_write(dst_level);
+         let (Some(dst_box), Some(src_box)) =
+             (self.staging.get(dst_level), src.staging.get(src_level))
+         else {
+@@ -1779,6 +1779,7 @@ impl TextureInner {
+         if !self.ensure_staging_for_write(dst_level, whole) {
+             return false;
+         }
++        self.prepare_staging_write(dst_level);
+         let Some(dst_box) = self.staging.get(dst_level) else {
+             return false;
+         };
+@@ -1984,6 +1985,7 @@ impl TextureInner {
+         if !self.ensure_staging_for_write(dst_level, whole) {
+             return false;
+         }
++        self.prepare_staging_write(dst_level);
+         let Some(dst_box) = self.staging.get(dst_level) else {
+             return false;
+         };
+@@ -2097,6 +2099,7 @@ impl TextureInner {
+         // A fill is a write: a level whose staging was never materialized (or
+         // was dropped after its upload) gets one here, like any first write.
+         self.ensure_staging(level);
++        self.prepare_staging_write(level);
+         let Some(box_) = self.staging.get(level) else {
+             return false;
+         };
+@@ -2734,6 +2737,28 @@ impl TextureInner {
+             .as_mut_ptr()
+     }
+ 
++    /// Rename a 2D level's staging before a CPU
++    /// write (UpdateSurface / UpdateTexture / fill) when an earlier recorded upload
++    /// still reads it, exactly as `lock_region_ptr` does for LockRect. The old Arc
++    /// stays owned by the queued upload job, so it reads the old bytes; the fresh
++    /// box starts as a full CPU copy so a partial dirty rect keeps the rest.
++    /// Call after `ensure_staging_for_write` / `ensure_staging`.
++    fn prepare_staging_write(&mut self, level: usize) {
++        if self.flags.contains(TextureFlags::VOLUME_TEXTURE) {
++            self.prepare_volume_staging_write(level);
++            return;
++        }
++        if self.device_inner == 0 || self.dropped_staging & (1u32 << level) != 0 {
++            return;
++        }
++        let coherent_seq = self.staging_coherent_seq(level);
++        let contended = is_in_flight(self.last_submit_seq[level], coherent_seq)
++            || self.staging[level].has_readers();
++        if contended {
++            self.rename_staging(level, PreserveKind::Cpu);
++        }
++    }
++
