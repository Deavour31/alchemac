diff --git a/patches/wine/0039-winemac.drv-Keep-a-cursor-s-size-in-points-in-Retina.patch b/patches/wine/0039-winemac.drv-Keep-a-cursor-s-size-in-points-in-Retina.patch
new file mode 100644
index 0000000..3502d69
--- /dev/null
+++ b/patches/wine/0039-winemac.drv-Keep-a-cursor-s-size-in-points-in-Retina.patch
@@ -0,0 +1,38 @@
+From 12f3c8770be19779603131798e00dd029734ca2f Mon Sep 17 00:00:00 2001
+From: Broyojo <dha@xoba.com>
+Date: Tue, 20 Oct 2026 02:01:40 -0400
+Subject: [PATCH] winemac.drv: Keep a cursor's size in points in Retina mode.
+
+A cursor's image covered half as many points as it has pixels in Retina
+mode, so a game's own cursor was half the size of the Mac's pointer and
+of the same cursor without Retina mode.
+---
+ dlls/winemac.drv/cocoa_app.m | 6 ++++--
+ 1 file changed, 4 insertions(+), 2 deletions(-)
+
+diff --git a/dlls/winemac.drv/cocoa_app.m b/dlls/winemac.drv/cocoa_app.m
+index 606cd20383..c42327430d 100644
+--- a/dlls/winemac.drv/cocoa_app.m
++++ b/dlls/winemac.drv/cocoa_app.m
+@@ -1084,14 +1084,16 @@ - (void) setCursor
+     {
+         NSDictionary* frame = cursorFrames[cursorFrame];
+         CGImageRef cgimage = (CGImageRef)frame[@"image"];
++        /* A cursor covers a point for each of its pixels, in Retina mode too, as the Mac's own
++           cursors do: halved to the display's pixels, a game's cursor is half the size of the
++           Mac's pointer and of what the game shows on a display without Retina mode. */
+         CGSize size = CGSizeMake(CGImageGetWidth(cgimage), CGImageGetHeight(cgimage));
+-        NSImage* image = [[NSImage alloc] initWithCGImage:cgimage size:NSSizeFromCGSize(cgsize_mac_from_win(size))];
++        NSImage* image = [[NSImage alloc] initWithCGImage:cgimage size:NSSizeFromCGSize(size)];
+         CFDictionaryRef hotSpotDict = (CFDictionaryRef)frame[@"hotSpot"];
+         CGPoint hotSpot;
+ 
+         if (!CGPointMakeWithDictionaryRepresentation(hotSpotDict, &hotSpot))
+             hotSpot = CGPointZero;
+-        hotSpot = cgpoint_mac_from_win(hotSpot);
+         self.cursor = [[[NSCursor alloc] initWithImage:image hotSpot:NSPointFromCGPoint(hotSpot)] autorelease];
+         [image release];
+         [self unhideCursor];
+-- 
+2.54.0 (Apple Git-157)
+
diff --git a/patches/wine/0040-ntdll-Keep-top-down-allocations-above-4GB-while-ther.patch b/patches/wine/0040-ntdll-Keep-top-down-allocations-above-4GB-while-ther.patch
new file mode 100644
index 0000000..d204d9f
--- /dev/null
+++ b/patches/wine/0040-ntdll-Keep-top-down-allocations-above-4GB-while-ther.patch
@@ -0,0 +1,54 @@
+From f3242c66243a5235256334f3e9aae425f5f10fb2 Mon Sep 17 00:00:00 2001
+From: Broyojo <dha@xoba.com>
+Date: Wed, 21 Oct 2026 09:22:22 -0400
+Subject: [PATCH] ntdll: Keep top-down allocations above 4GB while there is
+ room.
+
+map_view() looks in the reserved areas before free memory, highest area
+first. When a top-down request does not fit the top-down area, the next
+area down is the low one, so the request lands just below 4GB, although
+the address space between 4GB and the top-down area is free.
+
+Windows gives a top-down allocation the highest free address, and the
+space below 4GB is what programs needing 32-bit addresses depend on, such
+as LuaJIT asking for memory below 2GB with ZeroBits. FEX reserves large
+blocks top-down in every x64 process. Try the part of the range above 4GB
+first, the reserved areas and then free memory, and only then the rest.
+---
+ dlls/ntdll/unix/virtual.c | 20 ++++++++++++++++++++
+ 1 file changed, 20 insertions(+)
+
+diff --git a/dlls/ntdll/unix/virtual.c b/dlls/ntdll/unix/virtual.c
+index b1d805dd25..4451a28174 100644
+--- a/dlls/ntdll/unix/virtual.c
++++ b/dlls/ntdll/unix/virtual.c
+@@ -2524,6 +2524,26 @@ static NTSTATUS map_view( struct file_view **view_ret, void *base, size_t size,
+         if (limit_low && (void *)limit_low > start) start = (void *)limit_low;
+         if (limit_high && (void *)limit_high < end) end = (char *)limit_high + 1;
+ 
++#ifdef _WIN64
++        /* Windows gives a top-down allocation the highest free address, so it only goes below
++         * 4GB when nothing above is free. Don't let one that does not fit the top-down area
++         * fall into the low reserved area while there is room above 4GB: programs that need
++         * 32-bit addresses depend on that space. */
++        if (top_down && start < (void *)limit_4g && end > (void *)limit_4g)
++        {
++            if ((ptr = map_reserved_area( (void *)limit_4g, end, host_size, top_down, unix_prot, align_mask )))
++            {
++                TRACE( "got mem in reserved area %p-%p\n", ptr, (char *)ptr + size );
++                goto done;
++            }
++            if ((ptr = map_free_area( (void *)limit_4g, end, host_size, top_down, unix_prot, align_mask )))
++            {
++                TRACE( "got mem with map_free_area %p-%p\n", ptr, (char *)ptr + size );
++                goto done;
++            }
++        }
++#endif
++
+         if ((ptr = map_reserved_area( start, end, host_size, top_down, unix_prot, align_mask )))
+         {
+             TRACE( "got mem in reserved area %p-%p\n", ptr, (char *)ptr + size );
+-- 
+2.54.0 (Apple Git-157)
+
diff --git a/patches/wine/0041-ntdll-Return-FALSE-from-RtlIsEcCode-for-addresses-ab.patch b/patches/wine/0041-ntdll-Return-FALSE-from-RtlIsEcCode-for-addresses-ab.patch
new file mode 100644
index 0000000..4d66fa2
--- /dev/null
+++ b/patches/wine/0041-ntdll-Return-FALSE-from-RtlIsEcCode-for-addresses-ab.patch
@@ -0,0 +1,50 @@
+From 342cb56a59826c8f3896163e8261a6f188897b98 Mon Sep 17 00:00:00 2001
+From: Broyojo <dha@xoba.com>
+Date: Wed, 21 Oct 2026 09:22:23 -0400
+Subject: [PATCH] ntdll: Return FALSE from RtlIsEcCode for addresses above the
+ user space.
+
+An unwinder asks RtlIsEcCode about whatever it takes for a return
+address, and RtlIsEcCode indexed the EC code bitmap with it unchecked.
+A value past the bitmap faulted, and dispatching that fault unwound
+through the same frames and faulted again until the stack overflowed.
+
+Size the bitmap for the whole 47-bit user address space whatever the
+host's limit, and return FALSE for addresses above it.
+---
+ dlls/ntdll/signal_arm64ec.c | 3 +++
+ dlls/ntdll/unix/virtual.c   | 4 +++-
+ 2 files changed, 6 insertions(+), 1 deletion(-)
+
+diff --git a/dlls/ntdll/signal_arm64ec.c b/dlls/ntdll/signal_arm64ec.c
+index beea4ecabb..45e847a105 100644
+--- a/dlls/ntdll/signal_arm64ec.c
++++ b/dlls/ntdll/signal_arm64ec.c
+@@ -1394,6 +1394,9 @@ BOOLEAN WINAPI RtlIsEcCode( ULONG_PTR ptr )
+ {
+     const UINT64 *map = (const UINT64 *)NtCurrentTeb()->Peb->EcCodeBitMap;
+     ULONG_PTR page = ptr / page_size;
++
++    /* the map covers the 47-bit user address space; an unwinder can ask about any value */
++    if (ptr >> 47) return FALSE;
+     return (map[page / 64] >> (page & 63)) & 1;
+ }
+ 
+diff --git a/dlls/ntdll/unix/virtual.c b/dlls/ntdll/unix/virtual.c
+index 4451a28174..8e0497e0ca 100644
+--- a/dlls/ntdll/unix/virtual.c
++++ b/dlls/ntdll/unix/virtual.c
+@@ -3197,7 +3197,9 @@ BOOL is_emulated_code( ULONG_PTR ptr )
+ static void alloc_arm64ec_map(void)
+ {
+     unsigned int status;
+-    SIZE_T size = ((ULONG_PTR)address_space_limit + page_size) >> (page_shift + 3);  /* one bit per page */
++    /* one bit per page of the 47-bit user address space, whatever the host's limit, so that
++     * RtlIsEcCode only has to check that an address is below 1 << 47 */
++    SIZE_T size = ((ULONG_PTR)1 << 47) >> (page_shift + 3);
+ 
+     size = ROUND_SIZE( 0, size, host_page_mask );
+     status = map_view( &arm64ec_view, NULL, size, MEM_TOP_DOWN, VPROT_READ | VPROT_COMMITTED, 0, 0, 0 );
+-- 
+2.54.0 (Apple Git-157)
+
