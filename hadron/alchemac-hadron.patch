+#!/usr/bin/env python3
+"""Initialization failure/retry and foreign-prefix protection regression checks."""
+import argparse
+import json
+import os
+from pathlib import Path
+import shutil
+import struct
+import subprocess
+
+parser = argparse.ArgumentParser()
+for flag in ('runtime', 'fixture', 'state', 'out'):
+    parser.add_argument('--' + flag, required=True, type=Path)
+args = parser.parse_args()
+runtime, fixture, state, out = (p.resolve() for p in (args.runtime, args.fixture, args.state, args.out))
+assert not state.exists()
+state.mkdir(parents=True)
+out.mkdir(parents=True, exist_ok=True)
+results = []
+
+
+def check(name, condition):
+    results.append({'test': name, 'passed': bool(condition)})
+    (out / 'results.json').write_text(json.dumps(results, indent=2))
+    print(('ok   ' if condition else 'FAIL ') + name, flush=True)
+    if not condition:
+        raise AssertionError(name)
+
+
+def run(rt, prefix, support=None):
+    env = {k: os.environ[k] for k in ('HOME', 'USER', 'TMPDIR') if k in os.environ}
+    env.update(PATH='/usr/bin:/bin:/usr/sbin:/sbin', LANG='en_US.UTF-8',
+               WINEPREFIX=str(prefix), HADRON_SUPPORT=str(support or state / 'support'),
+               HADRON_LOGS=str(out / prefix.name), FEX_DISKCACHE='0')
+    with (out / (prefix.name + '-' + rt.name + '.outer.log')).open('w') as log:
+        p = subprocess.Popen([str(rt / 'scripts/standalone-run'), 'failure-test', str(fixture), 'exit', '0'],
+                             env=env, stdout=log, stderr=subprocess.STDOUT)
+        try:
+            return p.wait(timeout=80)
+        except BaseException:
+            p.terminate()
+            p.wait(timeout=20)
+            raise
+
+
+# This is an entirely synthetic shell runtime, not a modified signed Wine loader.
+mock = state / 'mock-init-fail'
+(mock / 'dist/bin').mkdir(parents=True)
+shutil.copytree(runtime / 'scripts', mock / 'scripts', symlinks=True)
+(mock / 'BUILD-ID').write_text('mock-init-fail\n')
+(mock / 'dist/bin/wine').write_text('#!/bin/sh\nmkdir -p "$WINEPREFIX"\necho partial > "$WINEPREFIX/test-partial"\nexit 1\n')
+(mock / 'dist/bin/wineserver').write_text('#!/bin/sh\nexit 0\n')
+for name in ('wine', 'wineserver'):
+    (mock / 'dist/bin' / name).chmod(0o755)
+target = state / 'retry-prefix'
+check('injected initialization failure returns nonzero', run(mock, target) != 0)
+check('failed initialization never installs an incomplete prefix', not target.exists())
+check('only disposable staging data is removed', not list(state.glob('retry-prefix.hadron-new.*')))
+check('real runtime can retry same path successfully', run(runtime, target) == 0)
+check('successful retry has ARM64 ready marker', (target / '.hadron-prefix-ready').is_file())
+
+foreign = state / 'foreign-prefix'
+system32 = foreign / 'drive_c/windows/system32'
+system32.mkdir(parents=True)
+data = bytearray(128)
+data[:2] = b'MZ'
+struct.pack_into('<I', data, 60, 64)
+data[64:68] = b'PE\0\0'
+struct.pack_into('<H', data, 68, 0x8664)
+(system32 / 'ntdll.dll').write_bytes(data)
+(foreign / '.hadron-prefix-ready').write_text('foreign\n')
+(foreign / 'keep.txt').write_text('do not touch')
+check('x64 foreign prefix is explicitly refused', run(runtime, foreign) != 0)
+check('foreign DLL and data remain unchanged', (system32 / 'ntdll.dll').read_bytes() == bytes(data) and (foreign / 'keep.txt').read_text() == 'do not touch')
+
+long_prefix = state / 'long-path-prefix'
+check('deep runtime path is rejected before Wine bootstrap', run(runtime, long_prefix, state / ('deep-' + 'x' * 100)) == 2)
+check('path rejection does not create a prefix', not long_prefix.exists())
+print('all standalone failure/retry checks passed', flush=True)
